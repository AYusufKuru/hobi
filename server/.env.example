PORT=3001

# Comma-separated frontend origins (Vercel URL, localhost, etc.)
# CORS_ORIGIN=https://hobi.vercel.app,http://localhost:5173

# --- Database ---
# Local demo (ephemeral on most hosts — data wiped on redeploy):
DB_TYPE=sqlite

# Production: use a managed Postgres and set DATABASE_URL.
# Free options: Neon (https://neon.tech) or Supabase.
# Example:
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# When DATABASE_URL is set, DB_TYPE is ignored.
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false

# Or discrete Postgres fields (Docker / self-host):
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=govorbit
# DB_PASSWORD=govorbit
# DB_NAME=govorbit
